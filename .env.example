# GEMINI_API_KEY: Required for direct Google Gemini API calls (also accepts GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY).
# On Vercel: Set in Project Settings > Environment Variables as GEMINI_API_KEY.
# In local development: Add to your local .env file.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OPENROUTER_API_KEY: Optional API key for OpenRouter (https://openrouter.ai).
# Allows using OpenRouter models or routing requests when Gemini requests are unavailable.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# APP_URL: Optional base URL of the hosted application.
APP_URL=
# Login and live activity (server-side only; never use VITE_ prefixes).
# Set the user/admin passwords privately in Vercel, never in GitHub.
USER_PASSWORD=
ADMIN_PASSWORD=
# Connect an Upstash Redis database. KV_REST_API_URL / KV_REST_API_TOKEN
# are accepted aliases for the following variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Optional separate Gemini key for audio. Falls back to GEMINI_API_KEY.
GEMINI_AUDIO_API_KEY=
GEMINI_AUDIO_API_KEY_2=
GEMINI_AUDIO_API_KEY_3=
# Optional generateContent-compatible audio model; defaults to gemini-3.8-flash.
# Do not use OpenRouter model IDs or gemini-3.5-transcribe (Interactions API).
GEMINI_AUDIO_MODEL=

# Each pool reads the base variable followed by _1 through _20. Values may contain comma, semicolon or newline separated keys.
# Argon uses direct Argon, Flash, Flash-Lite, then their OpenRouter equivalents and openrouter/free.
# OpenRouter selections start on OpenRouter. Disable Auto Fallback for one primary-key attempt.
PROVIDER_TIMEOUT_MS=120000
FALLBACK_TIME_BUDGET_MS=150000

# Optional Deepgram subtitle provider, selected in the app. Primary and two backups.
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY_2=
DEEPGRAM_API_KEY_3=
# Optional pre-recorded multilingual model (default nova-3).
DEEPGRAM_MODEL=
